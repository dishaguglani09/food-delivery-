# ============================================================================
# The Indian Rasoi — Server Environment Configuration Template
# Copy this file to .env and replace with your real secrets and cluster URI.
# Never commit actual production secrets to version control.
# ============================================================================

# HTTP Server Port
PORT=5000

# MongoDB Atlas Connection String (Supports both MONGO_URI and MONGODB_URI)
# Replace <username>, <password>, and <cluster-url> with your real Atlas details:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/the_indian_rasoi?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/the_indian_rasoi?retryWrites=true&w=majority

# JWT Secret for Signing Authentication Tokens
JWT_SECRET=the_indian_rasoi_jwt_secret_dev_key_2026_royal_dining

# Customer Frontend Origin for CORS Protection
CLIENT_URL=http://localhost:5173

# Environment (development | production)
NODE_ENV=development
